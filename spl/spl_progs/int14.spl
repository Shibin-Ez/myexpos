// NOTE semId is semaphore file descriptor, semIndex is semaphore table index

// get systemcall number from user stack
alias syscallNo R1;
syscallNo = [[PTBR + 2 * ((SP - 5) / 512)] * 512 + (SP - 5) % 512];

// save user stack
alias userSP R2;
userSP = SP;
[PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE + 1] + 13] = SP;
SP = [PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE + 1] + 11] * 512 - 1;

// set mode flag
[PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE + 1] + 9] = syscallNo;

// get user area page number
alias userAreaPageNo R3;
userAreaPageNo = [PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE + 1] + 11];

if (syscallNo == 19) then // semLock
  alias semId R4;
  semId = [[PTBR + 2 * ((userSP - 4) / 512)] * 512 + (userSP - 4) % 512];

  // check validity
  if (semId < 0 || semId >= 8 || [userAreaPageNo * 512 + RESOURCE_TABLE_OFFSET + semId * 2] != 1) then
    // returnVal -1
    [[PTBR + 2 * ((userSP - 1) / 512)] * 512 + (userSP - 1) % 512] = -1;
  else
    // semId is valid

    // wait till semaphore is available
    alias semIndex R5;
    semIndex = [userAreaPageNo * 512 + RESOURCE_TABLE_OFFSET + semId * 2 + 1];
    while ([SEMAPHORE_TABLE + 4*semIndex] != -1 && [SEMAPHORE_TABLE + 4*semIndex] != [SYSTEM_STATUS_TABLE + 1 ]) do
      [PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE + 1] + 4] = WAIT_SEMAPHORE;
      [PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE + 1] + 5] = semIndex;
      
      // calling scheduler
      multipush(R1, R2, R3, R4, R5);
      call MOD_5;
      multipop(R1, R2, R3, R4, R5);
    endwhile;

    // semaphore is available

    // set lockingPID as currentPID
    [SEMAPHORE_TABLE + 4*semIndex] = [SYSTEM_STATUS_TABLE + 1];

    // retVal 0
    [[PTBR + 2 * ((userSP - 1) / 512)] * 512 + (userSP - 1) % 512] = 0;
  endif;
else
if (syscallNo == 20) then // semUnlock
  alias semId R4;
  semId = [[PTBR + 2 * ((userSP - 4) / 512)] * 512 + (userSP - 4) % 512];

  // check validity
  if (semId < 0 || semId >= 8 || [userAreaPageNo * 512 + RESOURCE_TABLE_OFFSET + semId * 2] != 1) then
    // returnVal -1
    [[PTBR + 2 * ((userSP - 1) / 512)] * 512 + (userSP - 1) % 512] = -1;
  else
    // semId is valid

    alias semIndex R5;
    semIndex = [userAreaPageNo * 512 + RESOURCE_TABLE_OFFSET + semId * 2 + 1];

    // check if lockingPID is valid
    if ([SEMAPHORE_TABLE + 4*semIndex] == -1) then
      // returnVal 0
      [[PTBR + 2 * ((userSP - 1) / 512)] * 512 + (userSP - 1) % 512] = 0;
    else

      // check if lockingPID is currentPID
      if ([SEMAPHORE_TABLE + 4*semIndex] == [SYSTEM_STATUS_TABLE + 1]) then
        // reset lockingPID to -1
        [SEMAPHORE_TABLE + 4*semIndex] = -1;

        // wake up all process in wait_semaphore with semIndex
        alias pid R6;
        pid = 0;
        while (pid < 16) do
          if ([PROCESS_TABLE + 16 * pid + 4] == WAIT_SEMAPHORE && [PROCESS_TABLE + 16 * pid + 5] == semIndex) then
            [PROCESS_TABLE + 16 * pid + 4] = READY;
            [PROCESS_TABLE + 16 * pid + 5] = -1;
          endif;
          pid = pid + 1;
        endwhile;

        // retVal 0
        [[PTBR + 2 * ((userSP - 1) / 512)] * 512 + (userSP - 1) % 512] = 0;
      else
        // returnVal -2
        [[PTBR + 2 * ((userSP - 1) / 512)] * 512 + (userSP - 1) % 512] = -2;
      endif;
    endif;
  endif;
endif;
endif;


// reset the mode flag to 0
[PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE + 1] + 9] = 0;

SP = [PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE + 1] + 13];
ireturn;