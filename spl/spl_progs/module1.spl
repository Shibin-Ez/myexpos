// Module 1: Process Manager

alias functionNum R1;
alias currentPID R2;

if (functionNum == 2) then // free user area page
  alias userAreaPageNo R3;
  userAreaPageNo = [PROCESS_TABLE + 16 * currentPID + 11];

  // invoke release page function - memmory manager module
  multipush(R1, R2, R3);
  alias arg1 R1;
  alias arg2 R2;
  arg1 = 2; // release page function number
  arg2 = userAreaPageNo;
  call MOD_2;
  multipop(R1, R2, R3);

  // iterate resource table and release all resources
  alias i R4;
  i = 0;
  while (i < 8) do
    if ([userAreaPageNo * 512 + RESOURCE_TABLE_OFFSET + i * 2] == SEMAPHORE) then
      // invoke release semaphore function - resource manager module
      multipush(R1, R2, R3, R4);
      alias arg1 R1;
      alias arg2 R2;
      arg1 = 7; // release resource function number
      arg2 = [userAreaPageNo * 512 + RESOURCE_TABLE_OFFSET + i * 2 + 1]; // semaphore index
      call MOD_0;
      multipop(R1, R2, R3, R4);
    else
    if ([userAreaPageNo * 512 + RESOURCE_TABLE_OFFSET + i * 2] == FILE) then
      // invoke close function - File Manager
      multipush(R1, R2, R3, R4);
      R1 = 4;
      R2 = [userAreaPageNo * 512 + RESOURCE_TABLE_OFFSET + i * 2 + 1]; // open file table index
      call MOD_3;
      multipop(R1, R2, R3, R4);
    endif;
    endif;
    i = i + 1;
  endwhile;
  
  return;
else
if (functionNum == 3) then // exit process
  // invoke free page table - same module
  multipush(R1, R2);
  alias arg1 R1;
  alias arg2 R2;
  arg1 = 4; // free page table function number
  arg2 = currentPID;
  call MOD_1;
  multipop(R1, R2);

  // invoke free user area page - same module
  multipush(R1, R2);
  arg1 = 2; // free user area page function number
  arg2 = currentPID;
  call MOD_1;
  multipop(R1, R2);

  // set process state to terminated
  alias process_table_entry R3;
  process_table_entry = PROCESS_TABLE + 16 * currentPID;
  [process_table_entry + 4] = TERMINATED;

  // wake up all process waiting for this process, set child process to orphan(ppid -1)
  alias pid R4;
  pid = 0;
  if ([process_table_entry + 9] != 9) then // mode flag is not exec
    while (pid < 16) do
      process_table_entry = PROCESS_TABLE + 16 * pid;
      if ([process_table_entry + 4] == WAIT_PROCESS && [process_table_entry + 5] == currentPID) then
        [process_table_entry + 4] = READY;
      endif;
    
      // check if ppid matches parent pid
      if ([process_table_entry + 2] == currentPID) then
        [process_table_entry + 2] = -1;
      endif;

      pid = pid + 1;
    endwhile;
  endif;

  return;
else
if (functionNum == 4) then // free page table
  // invalidate library pages
  [PTBR + 0] = -1;
  [PTBR + 1] = "0000";
  [PTBR + 2] = -1;
  [PTBR + 3] = "0000";

  // release all valid pages
  alias i R3;
  i = 2;
  while (i < PTLR * 2) do
    if ([PTBR + i] != -1) then
      // invoke release page function - memmory manager module
      multipush(R1, R2, R3);
      alias arg1 R1;
      alias arg2 R2;
      arg1 = 2; // release page function number
      arg2 = [PTBR + i];
      call MOD_2;
      multipop(R1, R2, R3);

      [PTBR + i] = -1;
      [PTBR + i + 1] = "0000";
    endif;
    i = i + 2;
  endwhile;

  // going through heap, stack in disk map table
  i = 2;
  while (i < 10) do
    if (i == 2 || i == 3 || i == 8 || i == 9) then
      if ([DISK_MAP_TABLE + 10 * currentPID + i] != -1) then
        // invoke release block function
        multipush(R1, R2, R3);
        functionNum = 4;
        alias blockNum R2;
        blockNum = [DISK_MAP_TABLE + 10 * currentPID + i];
        call MOD_2;
        multipop(R1, R2, R3);
      endif;
    endif;

    // invalidate all entries
    [DISK_MAP_TABLE + 10 * currentPID + i] = -1;
    i = i + 1;
  endwhile;

  return;
else
if (functionNum == 1) then // get pcb entry
  alias childPID R3;
  childPID = 0;
  while (childPID < 16) do
    if ([PROCESS_TABLE + 16 * childPID + 4] == TERMINATED) then
      break;
    endif;
    childPID = childPID + 1;
  endwhile;

  if (childPID == 16) then
    R0 = -1; // retVal
    return;
  endif;
  
  // now, childPID is the process id of child process
  [PROCESS_TABLE + 16 * childPID + 1] = childPID;
  [PROCESS_TABLE + 16 * childPID + 4] = ALLOCATED;
  [PROCESS_TABLE + 16 * childPID + 14] = PAGE_TABLE_BASE + 20 * childPID; // PTBR
  [PROCESS_TABLE + 16 * childPID + 15] = PTLR;
  R0 = childPID;
  return;
else
if (functionNum == 5) then // kill_all
  alias currentPID R2;

  // lock all valid files
  alias i R3;
  i = 0;
  while (i < MAX_FILE_NUM) do
    // check validity of inode index
    if ([INODE_TABLE + 16 * i + 1] != -1) then
      // aquire inode - Resource Manager
      multipush(R1, R2, R3);
      R1 = 4;
      R2 = i; // inodeIndex
      R3 = currentPID;
      call MOD_0;
      multipop(R1, R2, R3);
    endif;
    i = i + 1;
  endwhile;

  // for pager module
  i = 2;
  while (i < MAX_PROC_NUM - 1) do
    if (currentPID != [PROCESS_TABLE + 16 * i + 1] && [PROCESS_TABLE + 16 * i + 4] != TERMINATED) then
      // calling exit process - Process Manager self
      multipush(R1, R2, R3);
      R1 = 3;
      R2 = i; // pid
      call MOD_1;
      multipop(R1, R2, R3);
    endif;
    i = i + 1;
  endwhile;

  // release all vaild files
  i = 0;
  while (i < MAX_FILE_NUM) do
    // release inode - Resource Manager
    backup;
    R1 = 5;
    R2 = i; // inodeIndex
    R3 = currentPID;
    call MOD_0;
    restore;
  i = i + 1;
  endwhile;

  return;
endif;
endif;
endif;
endif;
endif;