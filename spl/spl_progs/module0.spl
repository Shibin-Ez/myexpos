// Module 0: Rescource Manager

alias functionNum R1;
alias currentPID R2;
alias retVal R0;

if (functionNum == 8) then // aquire terminal
  while ([TERMINAL_STATUS_TABLE] == 1) do // terminal status - busy
    [PROCESS_TABLE + currentPID*16 + 4] = WAIT_TERMINAL;
    multipush (R1, R2);
    
    call MOD_5; // calling scheduler
    
    multipop (R1, R2);
  endwhile;

  [TERMINAL_STATUS_TABLE + 0] = 1;
  [TERMINAL_STATUS_TABLE + 1] = currentPID;
  return;
else
if (functionNum == 9) then // release terminal
  if (currentPID == [TERMINAL_STATUS_TABLE + 1]) then
    [TERMINAL_STATUS_TABLE + 0] = 0;
    
    // setting all WAIT_TERMINAL to READY
    alias i R3;
    i = 0;
    while (i < 16) do
      if ([PROCESS_TABLE + i*16 + 4] == WAIT_TERMINAL) then
        [PROCESS_TABLE + i*16 + 4] = READY;
      endif;
      i = i + 1;
    endwhile;

    retVal = 0;
    return;
  else
    retVal = -1;
    return;
  endif;
else
if (functionNum == 3) then // aquire disk
  while ([DISK_STATUS_TABLE + 0] == 1) do // disk status - busy
    [PROCESS_TABLE + currentPID*16 + 4] = WAIT_DISK;
    multipush (R1, R2);
    
    call MOD_5; // calling scheduler
    
    multipop (R1, R2);
  endwhile;

  [DISK_STATUS_TABLE + 0] = 1;
  [DISK_STATUS_TABLE + 4] = currentPID;
  return;
else
if (functionNum == 6) then // aquire semaphore
  alias i R3;
  i = 0;

  // finding free entry in semaphore table
  while (i < 32) do
    if ([SEMAPHORE_TABLE + i*4] == -1) then
      break;
    endif;
    i = i + 1;
  endwhile;

  if (i == 32) then // no free semaphore
    retVal = -1;
    return;
  else
    [SEMAPHORE_TABLE + i*4] = -1; // locking PID
    [SEMAPHORE_TABLE + i*4 + 1] = 1; // process count
    retVal = i;
    return;
  endif;
else
if (functionNum == 7) then // release semaphore
  alias semIndex R3;

  // check if lockingPID is currentPID
  if ([SEMAPHORE_TABLE + semIndex*4] == currentPID) then
    // set lockingPID to -1
    [SEMAPHORE_TABLE + semIndex*4] = -1;

    // wake up all process in wait_semaphore with semIndex
    alias pid R4;
    pid = 0;
    while (pid < 16) do
      if ([PROCESS_TABLE + pid*16 + 4] == WAIT_SEMAPHORE && [PROCESS_TABLE + pid*16 + 5] == semIndex) then
        [PROCESS_TABLE + pid*16 + 4] = READY;
        [PROCESS_TABLE + pid*16 + 5] = -1;
      endif;
      pid = pid + 1;
    endwhile;

    // decrement process count in semaphore table
    [SEMAPHORE_TABLE + semIndex*4 + 1] = [SEMAPHORE_TABLE + semIndex*4 + 1] - 1;
  endif;
  return;
else
if (functionNum == 4) then // Aquire Inode
  alias inodeIndex R2;
  alias currentPID R3;

  // wait for file in a busy loop
  while ([FILE_STATUS_TABLE + 4 * inodeIndex] != -1) do // lockingPID
    [PROCESS_TABLE + currentPID*16 + 4] = WAIT_FILE;
    [PROCESS_TABLE + currentPID*16 + 5] = inodeIndex;
    
    // calling scheduler
    multipush (R1, R2, R3);
    call MOD_5;
    multipop (R1, R2, R3);
  endwhile;

  // Inode is now locked

  // check if the file is deleted
  if ([INODE_TABLE + inodeIndex*16 + 1] == -1) then // fileName
    R0 = -1; // retVal -1
    return;
  endif;

  // set lockingPID
  [FILE_STATUS_TABLE + 4 * inodeIndex] = currentPID;

  R0 = 0; // retVal 0
  return;
else
if (functionNum == 5) then // Release Inode
  alias inodeIndex R2;
  alias currentPID R3;
  
  // currentPID should be the lockingPID
  if (currentPID != [FILE_STATUS_TABLE + 4 * inodeIndex]) then
    R0 = -1; //retVal -1
    return;
  endif;

  // free the lockingPID
  [FILE_STATUS_TABLE + 4 * inodeIndex] = -1;

  // invoke all process in the wait_file + inodeIndex
  alias pid R4;
  pid = 0;
  while (pid < 16) do
    if ([PROCESS_TABLE + 16 * pid + 4] == WAIT_FILE && [PROCESS_TABLE + 16 * pid + 5] == inodeIndex) then
      [PROCESS_TABLE + 16 * pid + 4] = READY;
    endif;
    pid = pid + 1;
  endwhile;

  R0 = 0; // retVal
  return;
endif;
endif;
endif;
endif;
endif;
endif;
endif;