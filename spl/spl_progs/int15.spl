// INT 15 : Shutdown systemcall(21)

// set the modeflag
[PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE + 1] + 9] = 21;

// Shutdown should only be called by Shell process, and by root user
if ([SYSTEM_STATUS_TABLE + 1] != 2 || [PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE + 1] + 3] != ROOT) then
  // retVal -1
  [[PTBR + 2 * ((SP - 1) / 512)] * 512 + (SP - 1) % 512] = 0;
  [PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE + 1] + 9] = 0;
  ireturn;
endif;

// set stack to kernal
SP = [PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE + 1] + 11] * 512 - 1;

// kill all process (except idle, init, current process)
R1 = 5;
R2 = [SYSTEM_STATUS_TABLE + 1];
call MOD_1;

// iterate buffer table, write back dirty blocks
alias i R0;
i = 0;
while (i < 4) do
  if ([BUFFER_TABLE + 4 * i + 1] == 1) then // dirty
    // write back buffer to disk - invoke disk_store - device manager
    multipush(R0);
    R1 = 1;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    R3 = BUFFER_BASE + i; // pageNo
    R4 = [BUFFER_TABLE + 4 * i]; // blockNum
    call MOD_4;
    multipop(R0);
  endif;
  i = i + 1;
endwhile;

// commit changes in the inode table (same page has user table 59,60)
R1 = 1;
R2 = [SYSTEM_STATUS_TABLE + 1];
R3 = 59;
R4 = 3;
call MOD_4;

R1 = 1;
R2 = [SYSTEM_STATUS_TABLE + 1];
R3 = 60;
R4 = 4;
call MOD_4;

// commit changes in the root file
R1 = 1;
R2 = [SYSTEM_STATUS_TABLE + 1];
R3 = 62;
R4 = 5;
call MOD_4;

// commit changes in the disk free list
R1 = 1;
R2 = [SYSTEM_STATUS_TABLE + 1];
R3 = 61;
R4 = 2;
call MOD_4;

// commit changes in the user table

halt;